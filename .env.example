# Copy to .env and fill in the keys you have. Every variable is optional: without keys the app
# still runs, and only episode generation needs the OpenAI and ElevenLabs keys.

# Provider keys
# OpenAI: selects the news and writes the script (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# ElevenLabs: voices the dialogue (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# The Guardian Open Platform: optional news source for any topic
# (https://open-platform.theguardian.com/access/)
GUARDIAN_API_KEY=

# OpenAI model per pipeline stage
OPENAI_WRITE_MODEL=gpt-6-sol
OPENAI_SELECT_MODEL=gpt-6-luna

# ElevenLabs voices for the two fixed hosts (defaults: George and Sarah)
ELEVENLABS_HOST_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_ANALYST_VOICE_ID=EXAVITQu4vr4xnSDxMaL
